{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "User-facing changelog",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "version",
      "changes"
    ],
    "properties": {
      "version": {
        "type": "string",
        "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "changes": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "title",
            "description"
          ],
          "properties": {
            "type": {
              "enum": [
                "feature",
                "improvement",
                "fix"
              ]
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "tags": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
